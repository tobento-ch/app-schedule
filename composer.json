{
    "name": "tobento/app-schedule",
    "version": "2.0",
    "type": "library",
    "description": "App schedule support.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "schedule",
        "task"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-console": "^2.0",
        "tobento/app-event": "^2.0",
        "tobento/app-cache": "^2.0",
        "tobento/app-mail": "^2.0",
        "tobento/app-notifier": "^2.0",
        "tobento/service-schedule": "^2.0",
        "symfony/process": "^7.3",
        "guzzlehttp/guzzle": "^7.10"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-filesystem": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Schedule\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Schedule\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}